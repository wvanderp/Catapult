{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/package-format.tsbuildinfo",
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "composite": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"]
}
